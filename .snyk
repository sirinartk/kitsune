        id: 'npm:http-signature:20150122'
        path: debowerify > bower > request > http-signature
  'npm:mime:20170907':
    - debowerify > bower > request > form-data > mime:
        patched: '2023-08-31T15:15:32.079Z'
        id: 'npm:mime:20170907'
        path: debowerify > bower > request > form-data > mime
  'npm:uglify-js:20151024':
